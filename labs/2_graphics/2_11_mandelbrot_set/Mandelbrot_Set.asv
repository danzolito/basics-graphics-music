%% test_mandelbrot.m
% Тестовый скрипт для проверки интерактивного множества Мандельброта.
% Запускает mandelbrot_interactive() и проверяет, что окно создалось
% без ошибок. После запуска управляйте стрелками-клавишами:
%   W/S — вверх/вниз, A/D — влево/вправо, Q — зум+, E — зум-.

clear; clc; close all;

fprintf('=== Тест mandelbrot_interactive ===\n');

% ---- 1. Проверка наличия файла функции ----
if ~exist('mandelbrot_interactive', 'file')
    error('Функция mandelbrot_interactive не найдена в пути. Добавьте её в текущую папку.');
end
fprintf('[OK] функция mandelbrot_interactive найдена.\n');

% ---- 2. Подсчёт открытых фигур до запуска ----
figsBefore = findall(0, 'Type', 'figure');
nBefore = numel(figsBefore);
fprintf('     Открытых фигур до запуска: %d\n', nBefore);

% ---- 3. Запуск (окно откроется и останется открытым) ----
try
    mandelbrot_interactive();
    fprintf('[OK] mandelbrot_interactive() выполнилась без ошибок.\n');
catch err
    error('Ошибка при вызове mandelbrot_interactive:\n%s', err.message);
end

% ---- 4. Проверка, что новое окно действительно появилось ----
drawnow;  % дать графике обработать очередь
figsAfter = findall(0, 'Type', 'figure');
nAfter = numel(figsAfter);

if nAfter > nBefore
    fprintf('[OK] создано новое окно (всего фигур: %d).\n', nAfter);
else
    warning('Новое окно не обнаружено — возможно, оно было закрыто слишком быстро.');
end

% ---- 5. Проверка содержимого окна (наличие axes с image) ----
newFigs = setdiff(figsAfter, figsBefore);
if ~isempty(newFigs)
    f = newFigs(1);
    axs = findall(f, 'Type', 'axes');
    imgs = findall(f, 'Type', 'image');
    if isempty(axs)
        warning('В новом окне нет axes.');
    else
        fprintf('[OK] в окне найдено axes: %d.\n', numel(axs));
    end
    if isempty(imgs)
        warning('В новом окне нет объекта image (картинка не отрисована).');
    else
        fprintf('[OK] в окне найдено image-объектов: %d.\n', numel(imgs));
    end
end

fprintf('\n=== Все проверки пройдены ===\n');
fprintf('Попробуйте клавиши: W A S D — панорама, Q — зум+, E — зум-.\n');
fprintf('Закройте окно вручную, когда закончите.\n');

function mandelbrot_interactive()
% MANDELBROT_INTERACTIVE — интерактивное множество Мандельброта
%
% Управление:
%   W / S  — панорамирование вверх / вниз (Y)
%   A / D  — панорамирование влево / вправо (X)
%   Q      — приближение (zoom in)
%   E      — отдаление (zoom out)
%
% Запускать в MATLAB как обычный скрипт/файл с функцией.

    % ---- Начальное состояние ----
    xl        = [-2.5, 1.5];    % пределы по X
    yl        = [-1.5, 1.5];    % пределы по Y
    maxIter   = 10;            % максимум итераций
    resW      = 900;            % разрешение по ширине
    zoomStep  = 0.7;            % коэффициент приближения/отдаления
    panStep   = 0.1;            % доля обзора за одно нажатие WASD

    % ---- Окно и оси ----
    fig = figure('Name','Mandelbrot | WASD — панорама, Q/E — зум', ...
        'NumberTitle','off','Color','k', ...
        'ToolBar','none','MenuBar','none', ...
        'Position',[100 100 900 700], ...
        'KeyPressFcn', @keyHandler);

    ax = axes('Parent', fig, 'Position',[0 0 1 1], 'Visible','off');
    colormap(ax, jet(256));

    draw();

    % ================================================================
    function draw()
        % разрешение по высоте подбираем под текущее соотношение сторон
        aspect = (xl(2)-xl(1)) / (yl(2)-yl(1));
        w = resW;
        h = max(2, round(w / aspect));

        xv = linspace(xl(1), xl(2), w);
        yv = linspace(yl(1), yl(2), h);
        [X, Y] = meshgrid(xv, yv);
        C = X + 1i*Y;
        Z = zeros(size(C));
        iters  = maxIter * ones(size(C));
        active = true(size(C));

        for k = 1:maxIter
            Z(active)   = Z(active).^2 + C(active);
            escaped     = active & (abs(Z) > 2);
            iters(escaped) = k;
            active      = active & ~escaped;
            if ~any(active(:)); break; end
        end

        % логарифмическое окрашивание — лучше видно детали
        data = log(iters + 1);

        imagesc(ax, xv, yv, data);
        axis(ax, 'xy');
        set(ax, 'XLim', xl, 'YLim', yl, 'XTick', [], 'YTick', []);
        caxis(ax, [0 log(maxIter+1)]);

        title(ax, sprintf('X[%.5f, %.5f]   Y[%.5f, %.5f]   iter = %d', ...
            xl(1), xl(2), yl(1), yl(2), maxIter), ...
            'Color','w','FontSize',10,'Interpreter','none');
        drawnow;
    end

    % ================================================================
    function keyHandler(~, ev)
        dx = panStep * diff(xl);
        dy = panStep * diff(yl);
        cx = mean(xl);
        cy = mean(yl);

        switch lower(ev.Key)
            case 'w',   yl = yl + dy;                             % вверх
            case 's',   yl = yl - dy;                             % вниз
            case 'a',   xl = xl - dx;                             % влево
            case 'd',   xl = xl + dx;                             % вправо
            case 'q'                                              % zoom in
                xl = cx + (xl - cx) * zoomStep;
                yl = cy + (yl - cy) * zoomStep;
                % maxIter = min(maxIter + 5, 5000);
            case 'e'                                              % zoom out
                xl = cx + (xl - cx) / zoomStep;
                yl = cy + (yl - cy) / zoomStep;
                % maxIter = max(10, round(maxIter / 1.15));
        end
        draw();
    end
end